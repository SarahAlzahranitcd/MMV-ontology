@prefix : <http://w3id.org/mmv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://w3id.org/mmv#> .

<http://w3id.org/mmv> rdf:type owl:Ontology ;
                       owl:versionIRI <http://w3id.org/mmv/0.1> ;
                       owl:imports <http://www.w3.org/ns/prov-o-20130430> ,
                                   <http://xmlns.com/foaf/0.1/> ,
                                   <https://alex-randles.github.io/MQV/#> ;
                       <http://purl.1122org/ontology/bibo/status> "draft" ;
                       <http://purl.org/dc/terms/created> "2025-11-01"^^xsd:date ;
                       <http://purl.org/dc/terms/creator> "Sarah Alzahrani" ;
                       <http://purl.org/dc/terms/description> "A lifecycle-based vocabulary for describing metadata, provenance, and quality of mapping projects and artifacts." ;
                       <http://purl.org/dc/terms/issued> "2025-11-12"^^xsd:date ;
                       <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                       <http://purl.org/dc/terms/publisher> "\"Trinity College Dublin\"" ;
                       <http://purl.org/dc/terms/title> "The Mapping Metadata Vocabulary" ;
                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "mmv" ;
                       <http://purl.org/vocab/vann/preferredNamespaceUri> <http://w3id.org/mmv/> ;
                       owl:versionInfo 0.1 .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.1122org/ontology/bibo/status
<http://purl.1122org/ontology/bibo/status> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/type
<http://purl.org/dc/terms/type> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/usageNote
<http://purl.org/vocab/vann/usageNote> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
<http://www.w3.org/2004/02/skos/core#broader> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/homepage
<http://xmlns.com/foaf/0.1/homepage> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
<http://xmlns.com/foaf/0.1/name> rdf:type owl:AnnotationProperty .


###  https://alex-randles.github.io/MQV/#mappingPurpose
<https://alex-randles.github.io/MQV/#mappingPurpose> rdf:type owl:AnnotationProperty ;
                                                     rdfs:domain <http://w3id.org/mmv/#MappingArtifact> .


###  https://alex-randles.github.io/MQV/#resultMessage
<https://alex-randles.github.io/MQV/#resultMessage> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#anySimpleType
xsd:anySimpleType rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/eis/vocab/daq#hasDimension
<http://purl.org/eis/vocab/daq#hasDimension> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <http://w3id.org/mmvinCategory> .


###  http://purl.org/eis/vocab/daq#hasMetric
<http://purl.org/eis/vocab/daq#hasMetric> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://w3id.org/mmv/#QualityAssessment> ;
                                          rdfs:range <http://www.w3.org/ns/dqv#Metric> .

[ owl:inverseOf <http://purl.org/eis/vocab/daq#hasMetric> ;
   rdfs:subPropertyOf <http://w3id.org/mmvinDimension>
 ] .


###  http://w3id.org/mmvcomputedOn
<http://w3id.org/mmvcomputedOn> rdf:type owl:ObjectProperty ;
                                owl:inverseOf <http://w3id.org/mmvhasQualityMeasurement> ;
                                rdfs:domain <http://w3id.org/mmvQualityMeasurement> ;
                                rdfs:range rdfs:Resource .


###  http://w3id.org/mmvhasQualityAnnotation
<http://w3id.org/mmvhasQualityAnnotation> rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf [ owl:inverseOf <http://www.w3.org/ns/oa#hasTarget>
                                                             ] ;
                                          rdfs:range <http://w3id.org/mmvQualityAnnotation> ;
                                          rdfs:comment "Refers to a quality annotation. Quality annotation can be applied to any kind of resource, e.g., a dataset, a linkset, a graph, a set of triples. However, in the DQV context, this property is generally expected to be used in statements in which subjects are instances of dcat:Dataset or dcat:Distribution."@en ;
                                          rdfs:label "has quality annotation"@en .


###  http://w3id.org/mmvhasQualityMeasurement
<http://w3id.org/mmvhasQualityMeasurement> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://w3id.org/mmv/#MappingArtifact> ;
                                           rdfs:range <http://w3id.org/mmvQualityMeasurement> ;
                                           rdfs:comment "Refers to the performed quality measurements. Quality measurements can be performed to any kind of resource (e.g., a dataset, a linkset, a graph, a set of triples). However, in the DQV context, this property is generally expected to be used in statements in which subjects are instances of dcat:Dataset or dcat:Distribution."@en ;
                                           rdfs:label "has quality measurement"@en .


###  http://w3id.org/mmvhasQualityMetadata
<http://w3id.org/mmvhasQualityMetadata> rdf:type owl:ObjectProperty ;
                                        rdfs:range <http://w3id.org/mmvQualityMetadata> ;
                                        rdfs:comment "Refers to a grouping of quality information such as certificates, policies, measurements and annotations as a named graph. Quality information represented in such a grouping can pertain to any kind of resource (e.g., a dataset, a linkset, a graph, a set of triples). However, in the DQV context, this property is generally expected to be used in statements in which subjects are instances of dcat:Dataset or dcat:Distribution."@en ;
                                        rdfs:label "has quality metadata"@en .


###  http://w3id.org/mmvinCategory
<http://w3id.org/mmvinCategory> rdf:type owl:ObjectProperty ;
                                rdfs:domain <http://w3id.org/mmvDimension> ;
                                rdfs:range <http://w3id.org/mmvCategory> ;
                                <http://purl.org/vocab/vann/usageNote> "Categories are meant to systematically organize dimensions. The Data Quality Vocabulary defines no specific cardinality constraints for dqv:inCategory, since distinct quality frameworks might have different perspectives over a dimension. A dimension may therefore be associated to more than one category. However, those who define new quality metrics should try to avoid this as much as possible and assign only one category to the dimensions they define."@en ;
                                rdfs:comment "Represents the category a dimension is grouped in."@en ;
                                rdfs:label "in category"@en .


###  http://w3id.org/mmvinDimension
<http://w3id.org/mmvinDimension> rdf:type owl:ObjectProperty ;
                                 rdfs:range <http://w3id.org/mmvDimension> ;
                                 <http://purl.org/vocab/vann/usageNote> "Dimensions are meant to systematically organize metrics, quality certificates and quality annotations. The Data Quality Vocabulary defines no specific cardinality constraints for dqv:inDimension, since distinct quality frameworks might have different perspectives over a metric. A metric may therefore be associated to more than one dimension. However, those who define new quality metrics should try to avoid this as much as possible and assign only one dimension to the metrics they define. More than one dimension can be indicated for each quality annotation or certificate."@en ;
                                 rdfs:comment "Represents the dimensions a quality metric, certificate and annotation allow a measurement of."@en ;
                                 rdfs:label "in dimension"@en .


###  http://w3id.org/mmvisMeasurementOf
<http://w3id.org/mmvisMeasurementOf> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://purl.org/linked-data/cube#Observation> .


###  http://w3id.org/mmv/#evaluatesArtifact
<http://w3id.org/mmv/#evaluatesArtifact> rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf <http://www.w3.org/ns/prov#used> ;
                                         rdfs:domain <http://w3id.org/mmv/#QualityAssessment> ;
                                         rdfs:range <http://w3id.org/mmv/#MappingArtifact> ;
                                         rdfs:comment "evaluation activity that assesses the quality of a mapping artifact." ;
                                         rdfs:label "evaluatesArtifact" .


###  http://w3id.org/mmv/#hasAnalysis
<http://w3id.org/mmv/#hasAnalysis> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <http://w3id.org/mmv/#MappingProject> ;
                                   rdfs:range <http://w3id.org/mmv/#AnalysisActivity> ;
                                   rdfs:comment "Links a mapping project to its analysis phase, capturing early-stage information such as requirements, assumptions, risks, stakeholders, and input datasets." ;
                                   rdfs:label "hasAnalysis" .


###  http://w3id.org/mmv/#hasDesign
<http://w3id.org/mmv/#hasDesign> rdf:type owl:ObjectProperty ;
                                 rdfs:domain <http://w3id.org/mmv/#MappingProject> ;
                                 rdfs:range <http://w3id.org/mmv/#DesignActivity> ;
                                 rdfs:comment "Links a mapping project to its design phase, capturing mapping design decisions and their justifications." ;
                                 rdfs:label "hasDesign" .


###  http://w3id.org/mmv/#hasDevelopment
<http://w3id.org/mmv/#hasDevelopment> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#MappingProject> ;
                                      rdfs:range <http://w3id.org/mmv/#DevelopmentActivity> ;
                                      rdfs:comment "Links a mapping project to its development phase, capturing details about the implementation of the mapping, including tools, methods, and formats." ;
                                      rdfs:label "hasDevelopment" .


###  http://w3id.org/mmv/#hasMaintenance
<http://w3id.org/mmv/#hasMaintenance> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#MappingProject> ;
                                      rdfs:range <http://w3id.org/mmv/#MaintenanceActivity> ;
                                      rdfs:comment "Links a mapping project to its maintenance phase, capturing publication, versioning, and long-term management of mapping artifacts." ;
                                      rdfs:label "hasMaintenance" .


###  http://w3id.org/mmv/#hasTesting
<http://w3id.org/mmv/#hasTesting> rdf:type owl:ObjectProperty ;
                                  rdfs:domain <http://w3id.org/mmv/#MappingProject> ;
                                  rdfs:range <http://w3id.org/mmv/#TestingActivity> ;
                                  rdfs:comment "Links a mapping project to its testing phase, capturing validation activities and their outcomes." ;
                                  rdfs:label "hasTesting" .


###  http://w3id.org/mmv/#testsArtifact
<http://w3id.org/mmv/#testsArtifact> rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf <http://www.w3.org/ns/prov#used> ;
                                     rdfs:domain <http://w3id.org/mmv/#TestingActivity> ;
                                     rdfs:range <http://w3id.org/mmv/#MappingArtifact> ;
                                     rdfs:comment "Testing activity that validates a mapping artifact." ;
                                     rdfs:label "testsArtifact" .


###  http://www.w3.org/ns/oa#hasTarget
<http://www.w3.org/ns/oa#hasTarget> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/oa#motivation
<http://www.w3.org/ns/oa#motivation> rdf:type owl:ObjectProperty .


###  https://alex-randles.github.io/MQV/#hasMetricType
<https://alex-randles.github.io/MQV/#hasMetricType> rdf:type owl:ObjectProperty ;
                                                    rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> .


###  https://alex-randles.github.io/MQV/#wasDerivedFrom
<https://alex-randles.github.io/MQV/#wasDerivedFrom> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://www.w3.org/ns/prov#Entity> ;
                                                     rdfs:range <http://www.w3.org/ns/prov#Entity> .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/mmvexpectedDataType
<http://w3id.org/mmvexpectedDataType> rdf:type owl:DatatypeProperty ;
                                      rdfs:range xsd:anySimpleType ;
                                      rdfs:comment "Represents the expected data type for metric's observed value (e.g. xsd:boolean, xsd:double etc...)"@en ;
                                      rdfs:label "expected data type"@en .


###  http://w3id.org/mmvhasBackground
<http://w3id.org/mmvhasBackground> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <http://www.w3.org/ns/prov#Agent> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Provides a brief description of the background, expertise, or experience of a stakeholder involved in the mapping project." ;
                                   rdfs:label "hasBackground" .


###  http://w3id.org/mmvhasDesignDecision
<http://w3id.org/mmvhasDesignDecision> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://w3id.org/mmv/#DesignActivity> ;
                                       rdfs:range xsd:string ;
                                       rdfs:comment "Captures a design decision made during the mapping design phase." ;
                                       rdfs:label "hasDesignDecision" .


###  http://w3id.org/mmvhasJustification
<http://w3id.org/mmvhasJustification> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#DesignActivity> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "Provides the rationale or justification for a specific mapping design decision." ;
                                      rdfs:label "hasJustification" .


###  http://w3id.org/mmvhasMappingAlgorithm
<http://w3id.org/mmvhasMappingAlgorithm> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <http://w3id.org/mmv/#DevelopmentActivity> ;
                                         rdfs:range xsd:string ;
                                         rdfs:comment "Describes the algorithm or transformation logic used to implement the mapping." ;
                                         rdfs:label "hasMappingAlgorithm" .


###  http://w3id.org/mmvhasMappingFormat
<http://w3id.org/mmvhasMappingFormat> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#DevelopmentActivity> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "Specifies the concrete syntax or format in which the mapping is encoded." ;
                                      rdfs:label "hasMappingFormat" .


###  http://w3id.org/mmvhasPublisherName
<http://w3id.org/mmvhasPublisherName> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#MaintenanceActivity> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "Specifies the name of the person or organization responsible for publishing the mapping." ;
                                      rdfs:label "hasPublisherName" .


###  http://w3id.org/mmvhasPurpose
<http://w3id.org/mmvhasPurpose> rdf:type owl:DatatypeProperty ;
                                rdfs:domain <http://w3id.org/mmv/#AnalysisActivity> ;
                                rdfs:range xsd:string ;
                                rdfs:comment "Describes the intended purpose or goal of the mapping project." ;
                                rdfs:label "hasPurpose" .


###  http://w3id.org/mmvhasReleaseDate
<http://w3id.org/mmvhasReleaseDate> rdf:type owl:DatatypeProperty ;
                                    rdfs:comment "Indicates the date and time when a mapping artifact was released or published." ;
                                    rdfs:label "hasReleaseDate" .


###  http://w3id.org/mmvhasTestingResult
<http://w3id.org/mmvhasTestingResult> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#TestingActivity> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "Records the outcome of a testing or validation activity." ;
                                      rdfs:label "hasTestingResult" .


###  http://w3id.org/mmvhasTestingType
<http://w3id.org/mmvhasTestingType> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <http://w3id.org/mmv/#QualityAssessment> ,
                                                <http://w3id.org/mmv/#TestingActivity> ;
                                    rdfs:range xsd:string ;
                                    rdfs:comment "Specifies the type of testing or validation performed on a mapping artifact." ;
                                    rdfs:label "hasTestingType" .


###  http://w3id.org/mmvusesToolName
<http://w3id.org/mmvusesToolName> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain <http://w3id.org/mmv/#DevelopmentActivity> ;
                                  rdfs:range xsd:string ;
                                  rdfs:comment "Specifies the name of a tool used to implement the mapping." ;
                                  rdfs:label "usesToolName" .


###  http://w3id.org/mmvvalue
<http://w3id.org/mmvvalue> rdf:type owl:DatatypeProperty ;
                           rdfs:domain <http://w3id.org/mmvQualityMeasurement> .


###  http://w3id.org/mmv/mappingLanguage
<http://w3id.org/mmv/mappingLanguage> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#MappingArtifact> ;
                                      rdfs:range rdfs:Literal ;
                                      rdfs:comment "Mapping language / format (RML, SPARQL, SSSOM, AML…)" ;
                                      rdfs:label "mappingLanguage" .


###  http://w3id.org/mmv/mappingType
<http://w3id.org/mmv/mappingType> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain <http://w3id.org/mmv/#MappingArtifact> ;
                                  rdfs:range rdfs:Literal ;
                                  rdfs:comment "Mapping type (e.g., uplift mapping, ontology alignment, interlinking)" ;
                                  rdfs:label "mappingType" .


###  http://w3id.org/mmv/#hasAssumption
<http://w3id.org/mmv/#hasAssumption> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <http://w3id.org/mmv/#AnalysisActivity> ;
                                     rdfs:range xsd:string ;
                                     rdfs:comment "Captures assumptions made about the domain, source data, or target model during the analysis phase." ;
                                     rdfs:label "hasAssumption" .


###  http://w3id.org/mmv/#hasDescription
<http://w3id.org/mmv/#hasDescription> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#MappingArtifact> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "Description of the project" ;
                                      rdfs:label "hasDescription" .


###  http://w3id.org/mmv/#hasRequirement
<http://w3id.org/mmv/#hasRequirement> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#AnalysisActivity> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "requirements of the project" ;
                                      rdfs:label "hasRequirement" .


###  http://w3id.org/mmv/#hasRiskOrIssue
<http://w3id.org/mmv/#hasRiskOrIssue> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#AnalysisActivity> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "Risk or issues realted to the project" ;
                                      rdfs:label "hasRiskOrIssue" .


###  http://w3id.org/mmv/#projectEndTime
<http://w3id.org/mmv/#projectEndTime> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://w3id.org/mmv/#MappingProject> ;
                                      rdfs:range xsd:dateTime ;
                                      rdfs:comment "The time at which a project ended." ;
                                      rdfs:label "projectEndTime" .


###  http://w3id.org/mmv/#projectStartTime
<http://w3id.org/mmv/#projectStartTime> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain <http://w3id.org/mmv/#MappingProject> ;
                                        rdfs:range xsd:dateTime ;
                                        rdfs:comment "The time at which a project started." ;
                                        rdfs:label "projectStartTime" .


###  http://w3id.org/mmv/#version
<http://w3id.org/mmv/#version> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <http://w3id.org/mmv/#MappingArtifact> ;
                               rdfs:range xsd:string ;
                               rdfs:comment "version of the mapping" ;
                               rdfs:label "version" .


#################################################################
#    Classes
#################################################################

###  http://purl.org/eis/vocab/daq#Category
<http://purl.org/eis/vocab/daq#Category> rdf:type owl:Class ;
                                         owl:equivalentClass <http://w3id.org/mmvCategory> .


###  http://purl.org/eis/vocab/daq#Dimension
<http://purl.org/eis/vocab/daq#Dimension> rdf:type owl:Class ;
                                          owl:equivalentClass <http://w3id.org/mmvDimension> .


###  http://purl.org/eis/vocab/daq#Metric
<http://purl.org/eis/vocab/daq#Metric> rdf:type owl:Class .


###  http://purl.org/eis/vocab/daq#Observation
<http://purl.org/eis/vocab/daq#Observation> rdf:type owl:Class ;
                                            owl:equivalentClass <http://w3id.org/mmvQualityMeasurement> .


###  http://purl.org/eis/vocab/daq#QualityGraph
<http://purl.org/eis/vocab/daq#QualityGraph> rdf:type owl:Class ;
                                             owl:equivalentClass <http://w3id.org/mmvQualityMeasurementDataset> .


###  http://purl.org/linked-data/cube#DataSet
<http://purl.org/linked-data/cube#DataSet> rdf:type owl:Class .


###  http://purl.org/linked-data/cube#DimensionProperty
<http://purl.org/linked-data/cube#DimensionProperty> rdf:type owl:Class .


###  http://purl.org/linked-data/cube#MeasureProperty
<http://purl.org/linked-data/cube#MeasureProperty> rdf:type owl:Class .


###  http://purl.org/linked-data/cube#Observation
<http://purl.org/linked-data/cube#Observation> rdf:type owl:Class .


###  http://purl.org/vocommons/voaf#Vocabulary
<http://purl.org/vocommons/voaf#Vocabulary> rdf:type owl:Class .


###  http://w3id.org/mmvCategory
<http://w3id.org/mmvCategory> rdf:type owl:Class ;
                              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                              rdfs:comment "Represents a group of quality dimensions in which a common type of information is used as quality indicator."@en ;
                              rdfs:label "Category"@en .


###  http://w3id.org/mmvDimension
<http://w3id.org/mmvDimension> rdf:type owl:Class ;
                               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                               rdfs:comment "Represents criteria relevant for assessing quality. Each quality dimension must have one or more metric to measure it. A dimension is linked with a category using the dqv:inCategory property."@en ;
                               rdfs:label "Dimension"@en .


###  http://w3id.org/mmvQualityAnnotation
<http://w3id.org/mmvQualityAnnotation> rdf:type owl:Class ;
                                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://www.w3.org/ns/oa#motivation> ;
                                                             owl:hasValue <http://w3id.org/mmvqualityAssessment>
                                                           ] ;
                                       rdfs:subClassOf <http://www.w3.org/ns/oa#Annotation> ;
                                       rdfs:comment "Represents quality annotations, including ratings, quality certificates or feedback that can be associated to datasets or distributions. Quality annotations must have one oa:motivatedBy statement with an instance of oa:Motivation (and skos:Concept) that reflects a quality assessment purpose. We define this instance as dqv:qualityAssessment."@en ;
                                       rdfs:label "Quality Annotation"@en .


###  http://w3id.org/mmvQualityCertificate
<http://w3id.org/mmvQualityCertificate> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://w3id.org/mmvQualityAnnotation> ;
                                        rdfs:comment "An annotation that associates a resource (especially, a dataset or a distribution) to another resource (for example, a document) that certifies the resource's quality according to a set of quality assessment rules."@en ;
                                        rdfs:label "Quality Certificate"@en .


###  http://w3id.org/mmvQualityMeasurement
<http://w3id.org/mmvQualityMeasurement> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://purl.org/linked-data/cube#Observation> ;
                                        <http://purl.org/vocab/vann/usageNote> "The unit of measure in quality measurement should be specified through the property sdmx-attribute:unitMeasure as recommended by RDF Data Cube. The Ontology of units of Measure (OM) by Rijgersberg Et Al provides a list of HTTP dereferenceable unit of measures, which can be exploited as values for sdmx-attribute:unitMeasure."@en ;
                                        rdfs:comment "Represents the evaluation of a given dataset (or dataset distribution) against a specific quality metric."@en ;
                                        rdfs:label "Quality Measurement"@en .


###  http://w3id.org/mmvQualityMeasurementDataset
<http://w3id.org/mmvQualityMeasurementDataset> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://purl.org/linked-data/cube#DataSet> ;
                                               rdfs:comment "Represents a dataset of quality measurements, evaluations of one or more datasets (or dataset distributions) against specific quality metrics."@en ;
                                               rdfs:label "Quality Measurement Dataset"@en .


###  http://w3id.org/mmvQualityMetadata
<http://w3id.org/mmvQualityMetadata> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.w3.org/2004/03/trix/rdfg-1/Graph> ;
                                     <http://purl.org/vocab/vann/usageNote> "QualityMetadata containers do not necessary include all types of quality statements DQV can support. Implementers decide the granularity of containment. In the current version of DQV, we also leave open the choice of the containment technique. Implementers can use (RDF) graph containment. They may also use an appropriate property of their choice — for example (a subproperty of) dcterms:hasPart — to link instances of dqv:QualityMetadata with instances of other DQV classes."@en ;
                                     rdfs:comment "Represents quality metadata, it is defined to group quality certificates, policies, measurements and annotations under a named graph."@en ;
                                     rdfs:label "Quality Metadata"@en .


###  http://w3id.org/mmvQualityPolicy
<http://w3id.org/mmvQualityPolicy> rdf:type owl:Class ;
                                   rdfs:comment "Represents a policy or agreement that is chiefly governed by data quality concerns."@en ;
                                   rdfs:label "Quality Policy"@en .


###  http://w3id.org/mmvUserQualityFeedback
<http://w3id.org/mmvUserQualityFeedback> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://w3id.org/mmvQualityAnnotation> ,
                                                         <http://www.w3.org/ns/duv#UserFeedback> ;
                                         rdfs:comment "Represents feedback that users have on the quality of datasets or distributions. Besides dqv:qualityAssessment, which is the motivation required by all quality annotations, one of the predefined instances of oa:Motivation should be indicated as motivation to distinguish among the different kinds of feedback, e.g., classifications, questions."@en ;
                                         rdfs:label "User Quality feedback"@en .


###  http://w3id.org/mmv/#AnalysisActivity
<http://w3id.org/mmv/#AnalysisActivity> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/prov#wasAssociatedWith> ;
                                                          owl:allValuesFrom <http://www.w3.org/ns/prov#Agent>
                                                        ] ;
                                        rdfs:comment "Represents the analysis phase of a mapping project, where stakeholders, input datasets, requirements, assumptions, and potential risks are identified before mapping design and implementation." ;
                                        rdfs:label "AnalysisActivity" .


###  http://w3id.org/mmv/#DataSet
<http://w3id.org/mmv/#DataSet> rdf:type owl:Class ;
                               rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                               rdfs:comment "Represents a structured collection of data that serves as an input or output in a mapping project or activity." ;
                               rdfs:label "DataSet" .


###  http://w3id.org/mmv/#DesignActivity
<http://w3id.org/mmv/#DesignActivity> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/prov#wasAssociatedWith> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/prov#Agent>
                                                      ] ;
                                      rdfs:comment "Represents the design phase of a mapping project, where mapping decisions are made, including modeling choices, reuse considerations, and justifications for the selected approach." ;
                                      rdfs:label "DesignActivity" .


###  http://w3id.org/mmv/#DevelopmentActivity
<http://w3id.org/mmv/#DevelopmentActivity> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://www.w3.org/ns/prov#wasAssociatedWith> ;
                                                             owl:allValuesFrom <http://www.w3.org/ns/prov#Agent>
                                                           ] ;
                                           rdfs:comment "Represents the development phase of a mapping project, where mappings are implemented using specific tools, methods, algorithms, and formats." ;
                                           rdfs:label "DevelopmentActivity" .


###  http://w3id.org/mmv/#MaintenanceActivity
<http://w3id.org/mmv/#MaintenanceActivity> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://www.w3.org/ns/prov#wasAssociatedWith> ;
                                                             owl:allValuesFrom <http://www.w3.org/ns/prov#Agent>
                                                           ] ;
                                           rdfs:comment "Represents the maintenance phase of a mapping project, where mapping artifacts are published, versioned, updated, and maintained over time." ;
                                           rdfs:label "MaintenanceActivity" .


###  http://w3id.org/mmv/#MappingArtifact
<http://w3id.org/mmv/#MappingArtifact> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                                       rdfs:comment "A tangible output of a mapping project, such as an RML file, ontology alignment, or linkset." ;
                                       rdfs:label "MappingArtifact" .


###  http://w3id.org/mmv/#MappingProject
<http://w3id.org/mmv/#MappingProject> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://w3id.org/mmv/#hasAnalysis> ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onClass <http://w3id.org/mmv/#AnalysisActivity>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://w3id.org/mmv/#hasDesign> ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onClass <http://w3id.org/mmv/#DesignActivity>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://w3id.org/mmv/#hasDevelopment> ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onClass <http://w3id.org/mmv/#DevelopmentActivity>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://w3id.org/mmv/#hasMaintenance> ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onClass <http://w3id.org/mmv/#MaintenanceActivity>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://w3id.org/mmv/#hasTesting> ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onClass <http://w3id.org/mmv/#TestingActivity>
                                                      ] ;
                                      rdfs:comment "Represents a mapping project that encompasses the analysis, design, development, testing, and maintenance of one or more mapping artifacts." ;
                                      rdfs:label "MappingProject" .


###  http://w3id.org/mmv/#QualityAssessment
<http://w3id.org/mmv/#QualityAssessment> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://w3id.org/mmv/#TestingActivity> ,
                                                         <http://www.w3.org/ns/prov#Activity> ,
                                                         <https://alex-randles.github.io/MQV/#MappingAssessment> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://alex-randles.github.io/MQV/#hasQualityMeasurement> ;
                                                           owl:someValuesFrom <http://www.w3.org/ns/dqv#QualityMeasurement>
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://www.w3.org/ns/prov#wasAssociatedWith> ;
                                                           owl:allValuesFrom <http://www.w3.org/ns/prov#Agent>
                                                         ] ;
                                         rdfs:comment "Represents a quality assessment performed as part of the testing phase of a mapping project, focusing on the evaluation of mapping artifacts using quality metrics and assessment criteria." ;
                                         rdfs:label "QualityAssessment" .


###  http://w3id.org/mmv/#TestingActivity
<http://w3id.org/mmv/#TestingActivity> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://alex-randles.github.io/MQV/#hasQualityMeasurement> ;
                                                         owl:someValuesFrom <http://www.w3.org/ns/dqv#QualityMeasurement>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://www.w3.org/ns/prov#wasAssociatedWith> ;
                                                         owl:allValuesFrom <http://www.w3.org/ns/prov#Agent>
                                                       ] ;
                                       rdfs:comment "Represents the testing and validation phase of a mapping project, where mapping artifacts are tested, validated, and assessed to ensure correctness, consistency, and quality." ;
                                       rdfs:label "TestingActivity" .


###  http://www.w3.org/2000/01/rdf-schema#Resource
rdfs:Resource rdf:type owl:Class .


