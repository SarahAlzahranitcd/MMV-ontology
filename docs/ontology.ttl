                                                              [ <http://xmlns.com/foaf/0.1/name> "Riccardo Albertoni"
                                                              ] ;
                           <http://purl.org/dc/terms/description> "The Data Quality Vocabulary (DQV) is seen as an extension to DCAT to cover the quality of the data, how frequently is it updated, whether it accepts user corrections, persistence commitments etc. When used by publishers, this vocabulary will foster trust in the data amongst developers."@en ;
                           <http://purl.org/dc/terms/modified> "2016-08-26"^^xsd:date ,
